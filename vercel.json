{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control",           "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "functions": {
    "api/stripe-webhook.js":          { "maxDuration": 30 },
    "api/admin-clientes.js":          { "maxDuration": 30 },
    "api/create-checkout-session.js": { "maxDuration": 15 },
    "api/update-subscription.js":     { "maxDuration": 15 },
    "api/cancel-subscription.js":     { "maxDuration": 15 },
    "api/reactivate-subscription.js": { "maxDuration": 15 },
    "api/create-portal-session.js":   { "maxDuration": 15 }
  }
}
